# Database
DATABASE_URL=sqlite:///fraud_predictions.db

# Model / inference config
DEFAULT_CONFIG_PATH=configs/baseline_logistic.yaml

# Frontend -> API wiring
# Use http://localhost:8000 for local (non-Docker) runs,
# or http://api:8000 when running via docker-compose.
API_BASE_URL=http://localhost:8000

# MLflow (not read by application code today — app code points
# directly at sqlite:///mlflow.db via YAML config. Provided here as
# the conventional URI for running the `mlflow` CLI against the
# same store, e.g. `mlflow ui --backend-store-uri $MLFLOW_TRACKING_URI`.)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
