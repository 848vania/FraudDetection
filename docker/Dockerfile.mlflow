FROM python:3.11-slim

WORKDIR /app

# anyio>=4.15 breaks mlflow's Flask-in-FastAPI WSGI bridge
# (AttributeError: module 'anyio' has no attribute 'from_thread'), so it's pinned below.
RUN pip install --no-cache-dir "mlflow~=3.15.1" "anyio<4.15,>=4.0"

RUN useradd --create-home --uid 1000 appuser
USER appuser

EXPOSE 5000

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:///mlflow.db", \
     "--default-artifact-root", "/app/mlruns", \
     "--host", "0.0.0.0", "--port", "5000"]
